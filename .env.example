# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Next.js Public Variables (for web)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# OpenRouter (for AI image analysis)
OPENROUTER_API_KEY=your-openrouter-api-key

# Google Books API (optional, for better book lookup)
GOOGLE_BOOKS_API_KEY=your-google-books-api-key

# Solana Configuration
SOLANA_RPC_URL=https://api.devnet.solana.com
# Authority keypair as JSON array (generate with: solana-keygen new --outfile authority.json)
SOLANA_AUTHORITY_SECRET=[1,2,3,...,64]
