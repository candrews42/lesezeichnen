# Lesezeichnen Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# SUPABASE (Required)
# =============================================================================

# Your Supabase project URL
# Found at: Project Settings > API > Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key (safe for client-side)
# Found at: Project Settings > API > Project API keys > anon public
SUPABASE_ANON_KEY=eyJ...

# Supabase service role key (server-side only, keep secret!)
# Found at: Project Settings > API > Project API keys > service_role
# Only needed for admin operations
SUPABASE_SERVICE_KEY=eyJ...

# =============================================================================
# FUTURE: SOLANA (Phase 4)
# =============================================================================

# Solana RPC endpoint
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Your wallet's private key (for minting NFTs)
# SOLANA_PRIVATE_KEY=

# =============================================================================
# OPTIONAL
# =============================================================================

# User ID for skill operations (auto-detected if using Supabase Auth)
# LESEZEICHNEN_USER_ID=
